# Copy these names into Render > Environment (or your shell). Placeholders only.
PARKING_DB_HOST=your-mysql-host.example.com
PARKING_DB_PORT=3306
PARKING_DB_USER=parking_app
PARKING_DB_PASSWORD=change-me
PARKING_DB_NAME=smart_parking

# SSL for hosted MySQL: disabled | preferred | required | verify_ca | verify_identity
PARKING_DB_SSL_MODE=verify_ca
# Path to the provider's CA certificate (e.g. a Render Secret File named ca.pem)
PARKING_DB_SSL_CA=/etc/secrets/ca.pem

# Show Indian time when the database server runs on UTC
PARKING_DB_TIME_ZONE=+05:30
TZ=Asia/Kolkata

# Keep false in production: true lets "Initialise database" delete existing data
PARKING_ALLOW_DB_RESET=false

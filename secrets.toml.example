# Local development settings. Copy this file to .streamlit/secrets.toml
# and fill in your own values. secrets.toml is ignored by git - never upload it.
PARKING_DB_HOST = "localhost"
PARKING_DB_PORT = "3306"
PARKING_DB_USER = "your_mysql_user"
PARKING_DB_PASSWORD = "your_mysql_password"
PARKING_DB_NAME = "smart_parking"
PARKING_DB_SSL_MODE = "preferred"
# true only on your own laptop, where resetting the sample data is fine
PARKING_ALLOW_DB_RESET = "true"
